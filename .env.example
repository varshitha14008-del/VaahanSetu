# VaahanSetu -- environment template for the Java desktop app
# ---------------------------------------------------------------------
# Copy this file to `.env` (in the repo root) and fill in your team's
# shared Neon connection details. The `.env` file is gitignored and
# will NEVER be committed to the repo.
#
# How to load this in Java:
#   - Use a library like dotenv-java (https://github.com/dmeibus/env)
#     <dependency>
#       <groupId>io.github.cdimascio</groupId>
#       <artifactId>dotenv-java</artifactId>
#       <version>3.0.0</version>
#     </dependency>
#   - Or read with System.getenv("DB_URL") etc. after exporting these
#     as environment variables before launching the JVM.

# ---- Neon connection (shared by the whole team) --------------------
# Get these from the teammate who set up the Neon project.
# Format: jdbc:postgresql://<host>:5432/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://ep-your-project-name-12345.us-east-2.aws.neon.tech/vaahansetu?sslmode=require

# Neon project owner role (created when you signed up for Neon).
# This is NOT the vaahansetu_app role from the schema -- that role is
# only used for local PostgreSQL. Neon uses its own auth.
DB_USER=vaahansetu_owner

# The password Neon generated for you (shown on the dashboard once).
# Do NOT commit this. Share it with teammates via a private channel.
DB_PASSWORD=replace-with-your-neon-password

# ---- Optional: app behaviour ---------------------------------------
# Set to true to enable verbose SQL logging during development.
DB_DEBUG=false
