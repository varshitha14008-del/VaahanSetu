# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# IDE files
.idea/
.vscode/

# Build output
out/
build/
target/

# Environment variables and secrets
.env
.env.local
.env.*.local

# Neon CLI local config (contains connection details / API keys)
.neon/

# Neon CLI generates these when running `neon init` in a non-Java project folder.
# They are not part of the Java desktop app and should not be committed.
neon.ts
package.json
package-lock.json
node_modules/

# OS-generated files
.DS_Store
Thumbs.db